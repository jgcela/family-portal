# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Neon: Neon Console > tu proyecto > Connect.
# Usa la conexión "pooled" (el host contiene "-pooler") para la app en Vercel.
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Login (Better Auth) -----------------------------------------------------
# Secreto largo y aleatorio. Genera uno con:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Plataforma --------------------------------------------------------------
PLATFORM_NAME=School Portal
# Dominio raíz. En local: localhost  (las escuelas quedan en stmary.localhost:3000)
# En producción, p. ej.: schoolportal.app  (stmary.schoolportal.app)
PLATFORM_ROOT_DOMAIN=localhost
# Hosts extra permitidos para el login, separados por comas (p. ej. tu-app.vercel.app)
AUTH_EXTRA_HOSTS=
# Permite abrir escuelas como /s/<slug> (necesario en *.vercel.app sin dominio propio)
ALLOW_PATH_TENANTS=true

# --- Primera cuenta (solo para npm run db:seed) ------------------------------
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
