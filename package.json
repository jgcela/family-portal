    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "ical.js": "^2.2.1",
    "markdown-it": "^14.3.3",
